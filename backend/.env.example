PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/solola
CLIENT_URL=http://localhost:3000
TRUST_PROXY=loopback

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Anti-robots Cloudflare Turnstile. Vide = protection inactive.
# TURNSTILE_HOSTNAMES : domaine(s) du site, séparés par des virgules (jamais localhost en production).
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails (codes de récupération). Vide = aucun email : en développement, le code s'affiche dans la console.
# Avec Gmail : SMTP_USER = ton adresse Gmail, SMTP_PASS = un mot de passe d'application (16 lettres),
# pas le mot de passe du compte. Vérifie la configuration avec : pnpm mail:test ton@email.fr
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Vide = « Solola <SMTP_USER> ». Sinon, une adresse que ton compte SMTP a le droit d'utiliser.
MAIL_FROM=
