PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/solola
CLIENT_URL=http://localhost:3000
TRUST_PROXY=loopback

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Anti-robots Cloudflare Turnstile. Vide = protection inactive.
# TURNSTILE_HOSTNAMES : domaine(s) du site, séparés par des virgules (jamais localhost en production).
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Solola <no-reply@solola.app>"
